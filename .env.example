# Zoho Mail Europe: use the SMTP host shown in Zoho Mail's server configuration
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_FROM_NAME=SoneRadar
SMTP_USER=your-address@zohomail.eu
SMTP_APP_PASSWORD=your-app-specific-password
MAIL_RATE_WINDOW_MS=3600000
MAIL_RATE_LIMIT_GLOBAL=60
MAIL_RATE_LIMIT_PER_RECIPIENT=10
